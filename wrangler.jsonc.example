{
  "name": "noodl-flashcards",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-21",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/mcp"] },
  "d1_databases": [{ "binding": "DB", "database_name": "noodl-flashcards", "database_id": "REPLACE_WITH_NEW_DATABASE_ID" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "noodl-flashcards-media" }],
  "vars": {
    "TRUSTED_SITES_PROXY": "false",
    "ALLOWED_TRANSFER_HOSTS": "",
    "ALLOWED_IMAGE_HOSTS": ""
  }
}
